# ==============================================================================
# CleanTraffic Environment Variables Configuration Example
# Copy this file to .env and supply your private values. Never commit .env.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_64_character_cryptographically_random_hex_string

# Initial Administrator Credentials (used only on initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_initial_admin_password

# Primary Supabase / PostgreSQL Database Connection
# If using Supabase directly via connection string:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Storage Engine (options: 'supabase', 'firestore', 'postgres')
STORAGE_BACKEND=supabase

# Supabase Client Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# IP Geolocation & Threat Intelligence (IP2Location)
# NOTE: If you enter your key directly in the Admin Dashboard at /interface, 
# it is saved to the database automatically and you DO NOT need to set it here.
IP2LOCATION_API_KEY=your_ip2location_api_key

# Public Application / Gateway Endpoint
# The base URL where this CleanTraffic instance is deployed.
# Can be root domain (https://yourdomain.com) or API subdomain (https://api.yourdomain.com).
# Embedded into generated PHP and edge integration scripts.
CLEANTRAFFIC_ENDPOINT=https://yourdomain.com

# Stripe Billing & Subscriptions (Optional)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID=price_placeholder_id

# Email Service (Resend or SMTP - Optional)
RESEND_API_KEY=re_placeholder_api_key
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=CleanTraffic Security
