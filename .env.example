# ==============================================================================
# CleanTraffic Production Environment Configuration (.env)
# Copy this file to .env or add these variables directly in your platform settings
# (Railway, Render, Fly.io, or Google AI Studio Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SECURITY (MANDATORY)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Cryptographically random 64-character hex secret for signing sessions and visitor cookies.
# Generate via: openssl rand -hex 32
SESSION_SECRET=e7b4a2c91d8f3e5b6a0c4d2e8f1a3b5c7e9d0f2a4b6c8e1d3f5a7b9c0d2e4f6a

# Cookie security settings (defaults: lax and auto-secure in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 2. CENTRAL REDIS RAM CACHE & SESSION STORE (MANDATORY)
# ------------------------------------------------------------------------------
# Format: redis://default:password@host:port (or rediss:// for encrypted TLS)
# - Railway Redis plugin: automatically set as ${{Redis.REDIS_URL}}
# - Upstash / Redis Cloud: copy standard redis:// or rediss:// connection URI
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEED CREDENTIALS (USED ONLY ON FIRST BOOT IF DB IS EMPTY)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_initial_admin_password

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# Primary relational database connection string for classification logs and rules
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
STORAGE_BACKEND=supabase

# Supabase REST Client Credentials (optional if DATABASE_URL pool is configured)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 5. IP GEOLOCATION & THREAT INTELLIGENCE (IP2LOCATION)
# ------------------------------------------------------------------------------
# Authoritative IP intelligence for proxy/VPN/Tor/crawler detection.
# NOTE: Can also be saved directly in the Admin Dashboard at /interface.
IP2LOCATION_API_KEY=your_ip2location_api_key

# ------------------------------------------------------------------------------
# 6. PUBLIC GATEWAY ENDPOINT
# ------------------------------------------------------------------------------
# The public base URL where this CleanTraffic instance is deployed.
CLEANTRAFFIC_ENDPOINT=https://yourdomain.com

# ------------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS (STRIPE & EMAIL)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID=price_placeholder_id

RESEND_API_KEY=re_placeholder_api_key
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=CleanTraffic Security
