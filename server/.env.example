# YOUR SERVER CONFIGURATION
# Copy this file to a file named '.env' on your production server
# Replace the values below with your actual server details

# DATABASE URL (Format: postgresql://user:password@host:port/dbname)
DATABASE_URL=your_postgresql_url_here

# SESSION SECRET (A long random string to secure user logins)
SESSION_SECRET=a_very_long_random_string_here

# PORT (The port the app will run on, usually 5000)
PORT=5000

# NODE_ENV (Set to 'production' on your server)
NODE_ENV=production
